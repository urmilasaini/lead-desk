# Copy to .env for local development. On Vercel, set these in Project Settings -> Environment Variables.

# ---- AI (required) ----
# Google AI Studio key (free tier) - https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which model to use. Default: gemini-3.5-flash-lite (fast, about 1-2 s per call).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Models to try, in order, if the main model's daily quota runs out (each model has its own quota).
# Default: gemini-3.5-flash. Set it to an empty value to turn the fallback off.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash

# ---- Storage (required: leads are saved in Firestore) ----
# The Firebase service-account JSON, in any ONE of these forms (first one found wins):
#   FIREBASE_CREDENTIALS_BASE64  the JSON, base64-encoded (easiest on Vercel: no quoting or newline problems)
#   FIREBASE_CREDENTIALS         the JSON as text, on one line
#   firebase-service-account.json  a file in the project root (git-ignored)
# Create the base64 value with:  python -c "import base64,sys; print(base64.b64encode(open('key.json','rb').read()).decode())"
FIREBASE_CREDENTIALS_BASE64=

# Collection used by this app (default leaddesk_leads). Keep it separate from other tools' data.
# FIRESTORE_COLLECTION=leaddesk_leads
# AI response cache collection (default ai_cache)
# FIRESTORE_CACHE_COLLECTION=ai_cache

# Local experiments and tests only: keep leads in memory instead (lost on restart).
# STORAGE=memory
